+function StatusBars({ orders, t }) {
+  const counts = Object.keys(STATUS_META).map(k => ({ k, n: orders.filter(o => (o.status || 'new') === k).length }));
+  const max = Math.max(1, ...counts.map(c => c.n));
+  return (
+    <div className="p-5 rounded-3xl bg-white border border-ink-200 shadow-soft">
+      <h3 className="text-sm font-bold text-ink-900 font-display mb-4">{t('a_orders_status')}</h3>
+      <div className="space-y-3">
+        {counts.map(({ k, n }) => {
+          const m = STATUS_META[k];
+          return (
+            <div key={k} className="flex items-center gap-3">
+              <span className="w-32 shrink-0 flex items-center gap-1.5 text-[11px] font-bold text-ink-600">
+                <Icon name={m.icon} className="w-3.5 h-3.5" sw={2.4} style={{ color: m.bar }} />{t(m.key)}
+              </span>
+              <span className="flex-1 h-3 rounded-full bg-ink-100 overflow-hidden">
+                <span className="block h-full rounded-full transition-all duration-500" style={{ width: `${(n / max) * 100}%`, background: m.bar, minWidth: n ? '10px' : 0 }} />
+              </span>
+              <span className="w-7 text-right text-xs font-black text-ink-800 tnum">{n}</span>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
+
+function RevenueBars({ orders, t, lang }) {
+  const days = useMemo(() => {
+    const out = [];
+    for (let i = 6; i >= 0; i--) {
+      const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - i);
+      const next = new Date(d); next.setDate(d.getDate() + 1);
+      const sum = orders.filter(o => {
+        const od = new Date(o.created_at || 0);
+        return od >= d && od < next && (o.status || 'new') !== 'cancelled';
+      }).reduce((a, o) => a + (Number(o.total) || 0), 0);
+      out.push({ label: d.toLocaleDateString(lang === 'uz' ? 'uz-UZ' : 'ru-RU', { weekday: 'short' }), full: d.toLocaleDateString('ru-RU'), sum });
+    }
+    return out;
+  }, [orders, lang]);
+  const max = Math.max(1, ...days.map(d => d.sum));
+  const peak = days.reduce((a, b) => (b.sum > a.sum ? b : a), days[0]);
+
+  return (
+    <div className="p-5 rounded-3xl bg-white border border-ink-200 shadow-soft">
+      <h3 className="text-sm font-bold text-ink-900 font-display mb-1">{t('a_revenue_days')}</h3>
+      <p className="text-[11px] text-ink-400 mb-4 tnum">{money(days.reduce((a, d) => a + d.sum, 0))} {t('currency')}</p>
+      <div className="flex items-end gap-2 h-32 border-b border-ink-200 pb-0.5">
+        {days.map((d, i) => (
+          <div key={i} className="flex-1 h-full flex flex-col justify-end items-center gap-1 group relative" title={`${d.full}: ${money(d.sum)}`}>
+            {d.sum > 0 && d.sum === peak.sum && (
+              <span className="text-[10px] font-black text-brand-700 tnum whitespace-nowrap">{money(d.sum)}</span>
+            )}
+            <span className={cls('w-full rounded-t-[4px] transition-colors', d.sum ? 'bg-brand-500/85 group-hover:bg-brand-600' : 'bg-ink-200')}
+                  style={{ height: d.sum ? `${Math.max(6, (d.sum / max) * 100)}%` : '3px' }} />
+          </div>
+        ))}
+      </div>
+      <div className="flex gap-2 mt-1.5">
+        {days.map((d, i) => <span key={i} className="flex-1 text-center text-[10px] text-ink-400 font-semibold">{d.label}</span>)}
+      </div>
+    </div>
+  );
+}
