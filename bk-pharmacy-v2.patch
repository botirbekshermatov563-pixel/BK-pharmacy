+/* ---------------- data tab ---------------- */
+function DataTab({ store, t, lang, notify }) {
+  const [payload, setPayload] = useState('');
+  const [confirmReset, setConfirmReset] = useState(false);
+
+  const snapshot = () => JSON.stringify({ products: store.products, categories: store.categories, settings: store.settings }, null, 2);
+
+  const doExport = async () => {
+    const text = snapshot();
+    try {
+      const dl = (window.claude && window.claude.use) ? await window.claude.use('downloads') : null;
+      if (dl) { await dl.save({ filename: 'bk-pharmacy-data.json', data: text }); notify(t('a_saved')); return; }
+    } catch (e) { /* fall through */ }
+    try { await navigator.clipboard.writeText(text); notify(t('toast_copied')); return; } catch (e) { /* fall through */ }
+    setPayload(text);
+  };
+
+  const doImport = async () => {
+    try {
+      const data = JSON.parse(payload);
+      if (!data || !Array.isArray(data.products)) throw new Error('products[]');
+      const r = await store.api.replaceAll(data);
+      if (r.ok) { notify(t('a_saved')); setPayload(''); }
+    } catch (e) { notify(t('a_err') + ': ' + (e.message || 'JSON'), 'error'); }
+  };
+
+  return (
+    <div className="space-y-5 max-w-3xl">
+      <div className="p-5 rounded-3xl bg-white border border-ink-200 shadow-soft space-y-3">
+        <h3 className="text-sm font-bold text-ink-900 font-display flex items-center gap-2"><Icon name="database" className="w-4 h-4 text-brand-600" />{t('a_storage')}</h3>
+        <p className="text-xs text-ink-500 leading-relaxed">{store.backend === 'db' ? t('a_storage_db') : t('a_storage_local')}</p>
+        <div className="flex flex-wrap gap-2 pt-1">
+          <Button variant="ghost" icon="download" onClick={doExport}>{t('a_export')}</Button>
+          <Button variant="dangerSoft" icon="refresh" onClick={() => setConfirmReset(true)}>{t('a_reset')}</Button>
+        </div>
+      </div>
+
+      <div className="p-5 rounded-3xl bg-white border border-ink-200 shadow-soft space-y-3">
+        <h3 className="text-sm font-bold text-ink-900 font-display">{t('a_import')}</h3>
+        <TextArea rows="8" value={payload} onChange={e => setPayload(e.target.value)} placeholder={t('a_import_ph')} className="font-mono text-[11px]" />
+        <div className="flex justify-end gap-2">
+          <Button variant="ghost" icon="copy" onClick={() => setPayload(snapshot())}>{lang === 'uz' ? 'Joriy ma’lumot' : 'Текущие данные'}</Button>
+          <Button icon="upload" onClick={doImport} disabled={!payload.trim()}>{t('a_import')}</Button>
+        </div>
+      </div>
+
+      <Modal open={confirmReset} onClose={() => setConfirmReset(false)} width="max-w-sm">
+        <div className="p-6 text-center space-y-4">
+          <div className="w-14 h-14 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mx-auto"><Icon name="alert" className="w-7 h-7" /></div>
+          <h3 className="text-lg font-bold text-ink-900 font-display">{t('a_reset_warn')}</h3>
+          <div className="flex gap-2">
+            <Button variant="ghost" className="flex-1" onClick={() => setConfirmReset(false)}>{t('a_cancel')}</Button>
+            <Button variant="danger" className="flex-1" icon="refresh"
+                    onClick={async () => { const r = await store.api.resetFactory(); if (r.ok) notify(t('a_saved')); setConfirmReset(false); }}>{t('a_reset')}</Button>
+          </div>
+        </div>
+      </Modal>
+    </div>
+  );
+}
