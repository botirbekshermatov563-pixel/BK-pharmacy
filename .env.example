# ==========================================
# BK Pharmacy Supabase Configuration
# ==========================================
# 1. Зарегистрируйтесь на https://supabase.com
# 2. Создайте новый проект
# 3. Перейдите в Project Settings -> API
# 4. Скопируйте Project URL и anon public key
# 5. Переименуйте этот файл в .env и вставьте значения:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Примечание: если ключи не указаны, приложение автоматически работает
# в полноценном автономном офлайн-режиме (LocalStorage DB) без ошибок!
